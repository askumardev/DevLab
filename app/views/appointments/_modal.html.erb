<div id="modal" class="hidden modal" data-action="click->calendar#closeModal">
  <div class="modal-content" data-action="click->calendar#stopPropagation">

    <h3 id="modal-title">Book Appointment</h3>

    <!-- � UNIFIED FORM - Works for both NEW and EDIT -->
    <%= form_with model: Appointment.new, id: "appointment-form", method: :post do |f| %>
      <%= f.hidden_field :id, id: "appointment-id" %>

      <%= f.text_field :title, placeholder: "Title", id: "appointment-title" %><br>
      <%= f.datetime_local_field :start_time, id: "appointment-start-time" %><br>
      <%= f.datetime_local_field :end_time, id: "appointment-end-time" %><br>

      <div class="form-actions">
        <%= f.submit "Save", id: "appointment-submit" %>
        <button type="button" class="close-btn" data-action="click->calendar#closeModal">
      Close
    </button>

        <!-- Delete button - hidden by default, shown for edits -->
        <%= button_tag "Delete",
              type: "submit",
              formmethod: "delete",
              id: "delete-appointment-btn",
              style: "display: none;",
              data: { confirm: "Are you sure you want to delete this appointment?" } %>
      </div>
    <% end %>

    <button type="button" data-action="click->calendar#closeModal">Close</button>
  </div>
</div>
