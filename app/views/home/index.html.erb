
<div class="home-hero">
  <h1>Welcome to DevLab</h1>
  <p class="lead">A minimal Rails app running to explore the sample data and developer workflows.</p>

  <div class="links">
    <ul>
      <li><%= link_to 'View Articles', articles_path, class: 'button' %> |
          <%= link_to 'Chat room', chat_room_path, class: 'button' %> |
              <%= link_to 'Exp', experience_index_path, class: 'button' %> |
              <%= link_to 'React API Client', react_client_path, class: 'button' %>

  <section class="hello">
    <fieldset class="sections">
      <legend>Say Hello</legend>
      <div data-controller="hello">
        <input data-hello-target="name" type="text">

        <button data-action="click->hello#greet">Greet</button>

        <span data-hello-target="output"></span>
      </div>
    </fieldset>
  </section>

  <section class="rating-widget">
    <fieldset class="sections">
      <legend>Share a rating</legend>
      <%= rating_form_for(page_name: 'home#index') %>
    </fieldset>
  </section>
</div>
